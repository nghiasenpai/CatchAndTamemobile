            if not isFlying then return end
            local cam = workspace.CurrentCamera
            local moveDir = Vector3.new()
            
            -- Mobile controls sử dụng joystick mặc định
            local moveVector = hum.MoveDirection
            if moveVector.Magnitude > 0 then
                moveDir = moveVector
            end
            
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
            
            flyBodyGyro2.CFrame = cam.CFrame
            if moveDir.Magnitude > 0 then
                flyBodyVelocity2.Velocity = moveDir.Unit * flySpeed
            else
                flyBodyVelocity2.Velocity = Vector3.new(0, 0, 0)
            end
        end)
    else
        if flyConn then flyConn:Disconnect() end
        if flyBodyVelocity2 then flyBodyVelocity2:Destroy() end
        if flyBodyGyro2 then flyBodyGyro2:Destroy() end
        hum.PlatformStand = false
    end
end)

