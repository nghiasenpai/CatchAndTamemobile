local function AddButton(name, color, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, buttonHeight)
    btn.BackgroundColor3 = color or Color3.fromRGB(40, 40, 50)
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = textSize
    btn.AutoButtonColor = true
    btn.Parent = Container
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
    
    -- Hỗ trợ cả touch và click
    btn.MouseButton1Click:Connect(callback)
    btn.Activated:Connect(function()
        if isMobile then
            callback()
        end
    end)
    
    return btn
end

local function AddToggle(name, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, buttonHeight)
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    btn.Text = name .. " : [OFF]"
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = textSize
    btn.AutoButtonColor = true
    btn.Parent = Container
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
    
    local enabled = false
    local function updateState(newState)
        enabled = newState
        btn.Text = name .. " : " .. (enabled and "[ON]" or "[OFF]")
        btn.BackgroundColor3 = enabled and Color3.fromRGB(0, 140, 70) or Color3.fromRGB(35, 35, 45)
        btn.TextColor3 = enabled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 200, 200)
        callback(enabled)
    end

    btn.MouseButton1Click:Connect(function() updateState(not enabled) end)
    btn.Activated:Connect(function()
        if isMobile then
            updateState(not enabled)
        end
    end)
    
    return { SetState = updateState, GetState = function() return enabled end }
end

